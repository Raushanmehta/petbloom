  "faqSectionData": {
    "badgeText": "FAQS",
    "titleWhite": "Frequently Asked ",
    "titleColored": "Questions",
    "description": "Find answers to common questions about our pet grooming <br className=\"hidden sm:block\" /> services, care, and appointments.",
    "image": "https://plus.unsplash.com/premium_photo-1707410049087-8a0a5ab77bce?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8ZG9nJTIwb24lMjBiZWR8ZW58MHx8MHx8fDA%3D",
    "faqs": [
      {
        "id": "1",
        "question": "How often should I groom my pet?",
        "answer": "It depends on your pet’s breed, coat type, and lifestyle. Generally, we recommend grooming every 4–6 weeks to keep your pet clean, healthy, and looking their best."
      },
      {
        "id": "2",
        "question": "What does a standard grooming session include?",
        "answer": "Our pet grooming includes a full bath with premium shampoo, blow-drying, hair styling/haircut, nail trimming, ear cleaning, and a brush-out."
      },
      {
        "id": "3",
        "question": "Do you offer grooming for puppies and senior pets?",
        "answer": "Yes, absolutely! Our professional groomers are trained to handle puppies and senior pets with extra care, patience, and specialized gentle products."
      },
      {
        "id": "4",
        "question": "How long does a typical grooming session take?",
        "answer": "A standard grooming session typically takes between 1.5 to 3 hours depending on your pet's size, breed, coat condition, and the specific services requested."
      },
      {
        "id": "5",
        "question": "Do I need to book an appointment in advance?",
        "answer": "Yes, we highly recommend booking an appointment in advance to secure your preferred slot and ensure your pet gets dedicated, uninterrupted care."
      },
      {
        "id": "6",
        "question": "Can I bring my own shampoo if my pet has allergies?",
        "answer": "Please inform us beforehand! We use hypoallergenic, organic, and vet-approved products specifically tailored for pets with sensitive skin or allergies."
      }
    ]
  },
